# Existing project: jarvis. Connect dialog / Settings > API Keys.
# Publishable key (sb_publishable_...) is intentionally public; never put a secret/service_role key in either NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Exact public origin; used for auth redirects and mutation origin checks.
APP_URL=http://localhost:3000
# Production APP_URL=https://jarvis-ai-platform.vercel.app (set in Vercel).
# Missing Supabase enables an explicitly labelled browser-local demo.

# Optional LOCAL dedicated test account for npm run test:live. Not needed in Vercel.
# Run scripts with: node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.ts
# Never commit credentials.
JARVIS_TEST_EMAIL=
JARVIS_TEST_PASSWORD=

# Optional phase 3 background worker. Server only; never NEXT_PUBLIC_.
# Supabase > existing project > Settings > API Keys > Secret keys (sb_secret_...).
SUPABASE_SECRET_KEY=
# At least 32 random characters. Generate privately, e.g. openssl rand -hex 32.
CRON_SECRET=
# Optional Gmail OAuth web application in your Google Cloud project.
# Redirect: https://jarvis-ai-platform.vercel.app/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exactly 32 random bytes, base64. Generate privately: openssl rand -base64 32.
# Preserve this key while an account is connected; rotation requires reconnecting Gmail.
EMAIL_ENCRYPTION_KEY=
