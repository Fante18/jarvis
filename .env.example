# Supabase Project Settings > API. Publishable/anon key is intentionally public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Exact public origin; used for auth redirects and mutation origin checks.
APP_URL=http://localhost:3000
# Missing Supabase enables an explicitly labelled browser-local demo.

# Optional dedicated test account for npm run test:live. Never commit credentials.
JARVIS_TEST_EMAIL=
JARVIS_TEST_PASSWORD=
